{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "node_modules/pdfkit/js/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "_comentario": "La página del reporte al cliente la sirve el servidor, no la SPA. Sin esta regla la caía el catch-all de abajo y Vercel devolvía el index.html de la app: el link que se le manda al cliente mostraba la pantalla de login en vez de su reporte. Verificado en producción el 14/9/2026 contra /r/9byru… — 200 OK sirviendo el index de la SPA. Va ANTES del catch-all: Vercel aplica la primera que matchea.",
      "source": "/r/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|r/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/anomalias",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/pulso-diario",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/cron/aprendizaje",
      "schedule": "20 10 * * 1"
    },
    {
      "path": "/api/cron/espejo-notion",
      "schedule": "5 10 * * 1"
    },
    {
      "path": "/api/cron/reportes",
      "schedule": "15 12 * * 1"
    },
    {
      "path": "/api/cron/mantenimiento",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/reconciliar",
      "schedule": "40 9 * * *"
    },
    {
      "path": "/api/cron/novedades",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/demanda-mercado",
      "schedule": "20 11 3 * *"
    }
  ],
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}