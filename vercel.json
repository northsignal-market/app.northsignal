{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/anomalias",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/aprendizaje",
      "schedule": "30 5 * * 1"
    },
    {
      "path": "/api/cron/mantenimiento",
      "schedule": "0 6 * * 1"
    }
  ]
}